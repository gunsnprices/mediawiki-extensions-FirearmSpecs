{
	"name": "gunsnprices/mediawiki-firearm-specs",
	"type": "mediawiki-extension",
	"description": "MediaWiki extension: parser functions that read caliber, model, magazine capacity, barrel length and rounds per box from firearm and ammunition titles, and compute the cost per round.",
	"keywords": [
		"mediawiki",
		"extension",
		"firearms",
		"ammunition",
		"caliber",
		"cost per round"
	],
	"homepage": "https://www.mediawiki.org/wiki/Extension:FirearmSpecs",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "GunsNPrices",
			"email": "app@gunsnprices.com",
			"homepage": "https://gunsnprices.com",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/gunsnprices/mediawiki-extensions-FirearmSpecs/issues",
		"source": "https://github.com/gunsnprices/mediawiki-extensions-FirearmSpecs",
		"email": "app@gunsnprices.com"
	},
	"require": {
		"php": ">=8.1",
		"composer/installers": "^2|^1.0.1",
		"gunsnprices/gunsnprices": "^0.1"
	},
	"extra": {
		"installer-name": "FirearmSpecs"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		},
		"prepend-autoloader": false,
		"optimize-autoloader": true
	}
}
